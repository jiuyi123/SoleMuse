.profile-edit-page { padding-top: 10px; }
.avatar-editor { display: flex; flex-direction: column; align-items: center; margin: 6px 0 20px; color: #5e7b91; font-size: clamp(12px, 1.6vw, 14px); }
.avatar-editor image { width: clamp(88px, 18vw, 128px); height: auto; margin-bottom: 8px; aspect-ratio: 1; border: 4px solid rgba(255,255,255,.9); border-radius: 50%; object-fit: cover; box-shadow: 0 7px 18px rgba(43,76,100,.16); }
.profile-form { width: 100%; padding: 4px clamp(14px, 3vw, 26px); }
.profile-field { display: grid; grid-template-columns: minmax(0, 1fr); gap: 7px; align-items: center; min-height: 76px; padding: 12px 0; border-bottom: 1px solid #e8eef1; color: #294860; font-size: clamp(13px, 1.8vw, 16px); }
.profile-field:last-child { border-bottom: 0; }
.profile-field input { width: 100%; min-width: 0; min-height: 42px; padding: 10px 12px; border-radius: 11px; background: rgba(239,246,248,.78); color: #456078; font-size: clamp(13px, 1.7vw, 15px); }
.privacy-note { display: block; margin: 12px 4px 20px; color: #8a98a8; font-size: clamp(11px, 1.5vw, 13px); line-height: 1.5; overflow-wrap: anywhere; }

@media (min-width: 600px) {
  .profile-field { grid-template-columns: minmax(120px, .35fr) minmax(0, 1fr); gap: 20px; }
}

@media (min-width: 900px) {
  .profile-edit-page { max-width: 820px; }
}
