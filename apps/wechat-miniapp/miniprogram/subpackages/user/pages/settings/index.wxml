<app-header title="设置" back transparent />

<view class="page settings-page">
  <view class="settings-group">
    <view wx:if="{{account}}" class="account-card">
      <image wx:if="{{account.avatarUrl}}" class="account-card__avatar" src="{{account.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="account-card__avatar account-card__avatar--fallback">{{accountInitial}}</view>
      <view class="settings-row__copy">
        <text class="settings-row__title">{{account.nickname}}</text>
        <text class="settings-row__description">账号 ID：{{account.accountId}}</text>
      </view>
      <text class="account-card__status">已登录</text>
    </view>
    <view wx:else class="account-card account-card--guest" bindtap="openLogin" aria-role="button" aria-label="去登录">
      <view class="account-card__avatar account-card__avatar--fallback">S</view>
      <view class="settings-row__copy">
        <text class="settings-row__title">登录 SoleMuse</text>
        <text class="settings-row__description">登录后同步你的作品与互动记录</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>
    <view wx:if="{{account}}" class="account-details">
      <view class="account-detail"><text>登录方式</text><text>{{account.loginMethodLabel}}</text></view>
      <view class="account-detail"><text>微信绑定</text><text>{{account.wechatDisplay}}</text></view>
      <view class="account-detail"><text>手机号</text><text>{{account.phoneDisplay}}</text></view>
    </view>
    <view class="settings-row">
      <view class="settings-row__copy">
        <text class="settings-row__title">隐私设置</text>
        <text class="settings-row__description">管理个人资料与内容公开范围</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>
    <view class="settings-row">
      <view class="settings-row__copy">
        <text class="settings-row__title">消息通知</text>
        <text class="settings-row__description">管理互动与系统通知提醒</text>
      </view>
      <text class="settings-row__arrow">›</text>
    </view>
  </view>

  <view class="settings-group">
    <view class="settings-row">
      <view class="settings-row__copy">
        <text class="settings-row__title">关于 SoleMuse</text>
        <text class="settings-row__description">AI 鞋履创意与设计灵感平台</text>
      </view>
      <text class="settings-row__value">V0.1.0</text>
    </view>
  </view>
</view>
