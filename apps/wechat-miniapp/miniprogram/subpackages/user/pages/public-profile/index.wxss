page { height: 100%; overflow: hidden; background: #f5f7f8; }
.public-profile-page { display: flex; height: 100%; min-height: 0; flex-direction: column; background: #f5f7f8; }
.public-header { position: relative; z-index: 20; flex: 0 0 auto; overflow: hidden; padding-bottom: 8px; border-bottom: 1px solid rgba(101, 132, 150, .17); background: linear-gradient(145deg, #e4eef2 0%, #edf2f3 56%, #f0e7e3 100%); }
.public-header::after { position: absolute; top: -45px; right: 12%; width: 130px; height: 110px; border-radius: 50%; background: rgba(224, 176, 157, .28); content: ""; filter: blur(28px); }
.public-header__bar { position: relative; z-index: 1; display: grid; grid-template-columns: 34px 52px minmax(0, 1fr); gap: 4px; align-items: center; min-width: 0; padding-left: 6px; }
.public-back { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 50%; }
.public-back:active { background: rgba(255, 255, 255, .5); }
.public-back__icon { width: 11px; height: 11px; margin-left: 4px; border-bottom: 2px solid #29485e; border-left: 2px solid #29485e; transform: rotate(45deg); }
.public-header__avatar { width: 52px; height: 52px; border: 2px solid rgba(255, 255, 255, .92); border-radius: 50%; box-shadow: 0 4px 12px rgba(46, 79, 99, .16); object-fit: cover; }
.public-header__avatar--fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #78b9b0, #5d91ba); color: #fff; font-size: 19px; font-weight: 700; }
.public-header__copy { display: flex; min-width: 0; flex-direction: column; }
.public-header__name { overflow: hidden; color: #18374e; font-size: 18px; font-weight: 700; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.public-header__region { margin-top: 2px; color: #748797; font-size: 11px; }
.public-header__placeholder { grid-column: 2 / 4; color: #29485e; font-size: 17px; font-weight: 600; }
.public-profile-scroll { height: 0; min-height: 0; flex: 1; background: #fff; }
.public-overview { padding: 12px 14px 16px; background: radial-gradient(circle at 84% 3%, rgba(230, 187, 169, .25), transparent 32%), linear-gradient(160deg, #e9f1f3 0%, #f0f3f3 58%, #f3ece8 100%); }
.public-social-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
.public-stats { display: flex; min-width: 0; align-items: stretch; }
.public-stat { display: flex; min-width: 43px; flex-direction: column; padding: 0 7px; border-right: 1px solid rgba(94, 124, 141, .2); }
.public-stat:first-child { padding-left: 0; }
.public-stat:last-child { border-right: 0; }
.public-stat__value { color: #18374e; font-size: 15px; font-weight: 700; line-height: 1.2; }
.public-stat__label { margin-top: 2px; color: #728493; font-size: 9px; white-space: nowrap; }
.public-actions { display: flex; align-items: center; gap: 6px; }
.follow-button, .message-button { display: flex; height: 34px; align-items: center; justify-content: center; border-radius: 17px; font-size: 12px; font-weight: 600; transition: transform 140ms ease, opacity 140ms ease; }
.follow-button:active, .message-button:active { opacity: .82; transform: scale(.97); }
.follow-button { min-width: 66px; padding: 0 10px; background: linear-gradient(135deg, #6dafaa, #5d91be); color: #fff; box-shadow: 0 5px 13px rgba(67, 126, 158, .18); }
.follow-button--active { border: 1px solid rgba(123, 153, 169, .34); background: rgba(255, 255, 255, .7); box-shadow: none; color: #537083; }
.follow-button__symbol { margin-right: 3px; font-size: 15px; font-weight: 500; }
.message-button { gap: 3px; min-width: 57px; padding: 0 8px; border: 1px solid rgba(123, 153, 169, .32); background: rgba(255, 255, 255, .74); color: #486a80; }
.message-button image { width: 17px; height: 17px; }
.public-role { display: block; margin-top: 13px; color: #6a7f8e; font-size: 11px; }
.public-bio { display: block; margin-top: 5px; color: #455f70; font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; }
.public-specialties { width: 100%; margin-top: 11px; white-space: nowrap; }
.public-specialties__inner { display: inline-flex; gap: 7px; }
.public-specialty { flex: 0 0 auto; padding: 5px 11px; border: 1px solid rgba(163, 189, 202, .48); border-radius: 999px; background: rgba(255, 255, 255, .52); color: #5d7688; font-size: 11px; }
.public-works { min-height: 420px; background: #fff; }
.public-works__heading { position: sticky; z-index: 8; top: 0; display: flex; height: 50px; align-items: center; justify-content: space-between; padding: 0 12px; background: rgba(255, 255, 255, .97); }
.public-works__title-wrap { position: relative; display: flex; height: 100%; align-items: center; }
.public-works__title { color: #263d4e; font-size: 15px; font-weight: 700; }
.public-works__indicator { position: absolute; right: 1px; bottom: 0; left: 1px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, #67afa6, #5a90bc); }
.public-works__count { color: #9aa3aa; font-size: 11px; }
.public-artwork-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 10px 10px 28px; }
.public-artwork-grid__item { min-width: 0; }

@media (max-width: 350px) {
  .public-overview { padding-right: 10px; padding-left: 10px; }
  .public-stat { min-width: 40px; padding-right: 5px; padding-left: 5px; }
  .follow-button { min-width: 61px; padding-right: 7px; padding-left: 7px; }
  .message-button { min-width: 53px; padding-right: 6px; padding-left: 6px; }
}

@media (min-width: 700px) {
  .public-profile-page { max-width: 980px; margin: 0 auto; }
  .public-header { border-radius: 0 0 22px 22px; }
  .public-header__bar { padding-left: 22px; }
  .public-overview { padding: 16px 28px 20px; }
  .public-artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 16px 20px 34px; }
  .public-works__heading { padding-right: 20px; padding-left: 20px; }
}
