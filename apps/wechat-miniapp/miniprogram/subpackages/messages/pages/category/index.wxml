<view class="category-page">
  <app-header title="{{title}}" back transparent />

  <page-state wx:if="{{loading}}" state="loading" title="正在整理消息" description="稍等一下。" />
  <page-state wx:elif="{{loadFailed}}" state="error" title="消息加载失败" description="请稍后重试。" action-text="重新加载" bind:action="loadMessages" />

  <scroll-view wx:elif="{{messages.length}}" class="category-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="id" class="category-item" data-id="{{item.id}}" bindtap="openNotification" aria-role="button">
      <image wx:if="{{item.avatarUrl}}" class="category-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="category-avatar category-avatar--{{item.tone}}">{{item.icon}}</view>
      <view class="category-content">
        <view class="category-heading">
          <text class="category-title">{{item.title}}</text>
          <text class="category-time">{{item.time}}</text>
        </view>
        <text class="category-summary">{{item.summary}}</text>
      </view>
      <image wx:if="{{item.artworkId && item.image}}" class="category-cover" src="{{item.image}}" mode="aspectFill" />
      <view wx:if="{{item.type === 'follow'}}" class="category-arrow"></view>
    </view>
  </scroll-view>

  <page-state wx:else title="还没有消息" description="新的互动会出现在这里。" />
</view>
