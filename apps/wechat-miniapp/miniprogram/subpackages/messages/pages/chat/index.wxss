page {
  height: 100%;
  overflow: hidden;
  background: #f6f8fa;
}

.chat-shell {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  background: linear-gradient(180deg, #fff 0, #f6f8fa 18%, #f5f7f9 100%);
}

.chat-shell app-header { flex: 0 0 auto; }
.chat-presence { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: 5px; margin-top: -7px; padding-bottom: 9px; background: #fff; color: #9aa3ab; font-size: 11px; }
.chat-presence__dot { width: 6px; height: 6px; border-radius: 50%; background: #4ac99b; }

.chat-thread { height: 0; min-height: 0; flex: 1; }
.chat-thread__inner { padding: 18px 10px 24px; }
.chat-time { display: block; margin: 3px 0 15px; color: #adb4ba; font-size: 11px; line-height: 1; text-align: center; }
.chat-message { display: flex; width: 100%; align-items: flex-start; gap: 8px; margin-bottom: 18px; }
.chat-message--self { flex-direction: row-reverse; }
.chat-avatar-link { flex: 0 0 38px; width: 38px; height: 38px; border-radius: 50%; transition: opacity 130ms ease, transform 130ms ease; }
.chat-avatar-link:active { opacity: .76; transform: scale(.96); }
.chat-avatar-link .chat-avatar { width: 100%; height: 100%; }
.chat-avatar { flex: 0 0 38px; width: 38px; height: 38px; border: 1px solid rgba(206, 216, 223, 0.65); border-radius: 50%; object-fit: cover; }
.chat-avatar--fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #96e1d1, #65bcb0); color: #fff; font-size: 15px; font-weight: 600; }
.chat-bubble { max-width: min(72%, 520px); padding: 11px 14px; border-radius: 17px; font-size: 15px; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word; }
.chat-bubble--other { border-top-left-radius: 5px; background: #fff; color: #303940; box-shadow: 0 3px 12px rgba(47, 65, 78, 0.05); }
.chat-bubble--self { border-top-right-radius: 5px; background: linear-gradient(135deg, #70a9d3, #5d92c3); color: #fff; box-shadow: 0 5px 14px rgba(73, 125, 170, 0.16); }
.chat-bottom-anchor { height: 1px; }

.chat-composer { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; flex: 0 0 auto; align-items: center; gap: 8px; padding: 9px 10px calc(9px + env(safe-area-inset-bottom)); border-top: 1px solid #e9edf0; background: rgba(255, 255, 255, 0.96); }
.chat-input-wrap { min-width: 0; border: 1px solid #e5eaee; border-radius: 20px; background: #f5f7f8; }
.chat-input { width: 100%; height: 40px; padding: 0 15px; color: #2d363d; font-size: 15px; line-height: 40px; }
.chat-input::placeholder { color: #a5adb4; }
.chat-send { display: flex; width: 54px; height: 36px; align-items: center; justify-content: center; border-radius: 18px; background: #e8ecef; color: #a9b0b6; font-size: 13px; font-weight: 600; }
.chat-send--ready { background: linear-gradient(135deg, #72a9d1, #5d94c5); color: #fff; }
.chat-send-error { position: absolute; right: 12px; bottom: calc(54px + env(safe-area-inset-bottom)); color: #d95c67; font-size: 11px; }

@media (min-width: 700px) {
  .chat-thread__inner, .chat-composer { width: min(760px, 100%); margin-right: auto; margin-left: auto; }
}
