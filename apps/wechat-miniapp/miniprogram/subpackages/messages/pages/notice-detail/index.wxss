.notice-page { max-width: 860px; padding-top: 8px; }
.notice-cover { width: 100%; height: auto; aspect-ratio: 16 / 7; overflow: hidden; }
.notice-cover image { width: 100%; height: 100%; object-fit: cover; }
.notice-article { display: flex; flex-direction: column; margin-top: 14px; padding: clamp(22px, 4vw, 38px); }
.notice-label { color: #699b95; font-size: clamp(10px, 1.4vw, 12px); font-weight: 700; letter-spacing: clamp(1px, .4vw, 4px); overflow-wrap: anywhere; }
.notice-title { margin-top: 10px; color: #173754; font-family: "STKaiti",serif; font-size: clamp(22px, 3.5vw, 32px); font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.notice-time { margin-top: 8px; color: #98a4b0; font-size: clamp(11px, 1.4vw, 13px); }
.notice-paragraph { margin-top: clamp(18px, 3vw, 28px); color: #506b81; font-size: clamp(14px, 1.8vw, 17px); line-height: 1.85; overflow-wrap: anywhere; word-break: break-word; }
.notice-id { margin-top: 24px; padding-top: 14px; border-top: 1px solid #e4ebef; color: #98a5b2; font-size: clamp(10px, 1.3vw, 12px); overflow-wrap: anywhere; }
