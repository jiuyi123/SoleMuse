.detail-header {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  border-bottom: 1px solid rgba(190, 205, 214, 0.42);
  background: rgba(255, 255, 255, 0.96);
}

.detail-header__inner {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) auto;
  width: 100%;
  min-height: 68px;
  align-items: center;
  gap: clamp(8px, 2vw, 14px);
  margin: 0 auto;
  padding: 8px clamp(12px, 3vw, 24px);
}

.back-control {
  display: flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
}

.back-control__icon {
  width: 12px;
  height: 12px;
  margin-left: 5px;
  border-bottom: 2px solid #17344e;
  border-left: 2px solid #17344e;
  transform: rotate(45deg);
}

.creator-summary {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
}

.creator-avatar,
.comment-avatar {
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(145deg, #91b7c9, #315d79);
  color: #ffffff;
}

.creator-avatar {
  display: flex;
  width: clamp(36px, 8vw, 44px);
  height: clamp(36px, 8vw, 44px);
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.creator-copy {
  min-width: 0;
}

.creator-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-name {
  color: #17344e;
  font-size: clamp(13px, 2vw, 16px);
  font-weight: 600;
}

.creator-badges {
  display: flex;
  max-width: 100%;
  gap: 4px;
  margin-top: 3px;
  overflow: hidden;
}

.creator-badge {
  max-width: 100%;
  padding: 1px 5px;
  overflow: hidden;
  border-radius: 999px;
  background: #edf3f5;
  color: #8b99a5;
  font-size: clamp(9px, 1.4vw, 11px);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-actions {
  display: flex;
  flex: none;
  align-items: center;
}

.follow-control {
  display: flex;
  min-width: 58px;
  height: 34px;
  align-items: center;
  justify-content: center;
  padding: 0 13px;
  border: 1px solid #df8795;
  border-radius: 999px;
  color: #d85e73;
  font-size: 13px;
  line-height: 1;
}

.follow-control--active {
  border-color: #c8d3da;
  color: #7c8b96;
}

.detail-page {
  width: 100%;
  max-width: 1100px;
  min-height: 100vh;
  margin: 0 auto;
  padding-bottom: calc(82px + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f7fafb;
}

.gallery-section {
  position: relative;
  width: 100%;
  background: #eef3f5;
}

.artwork-swiper,
.artwork-image {
  width: 100%;
  height: clamp(320px, 92vw, 720px);
}

.artwork-image {
  object-fit: cover;
}

.image-count {
  position: absolute;
  z-index: 2;
  right: 16px;
  bottom: 92px;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(19, 52, 78, 0.66);
  color: #ffffff;
  font-size: 11px;
}

.thumbnail-scroll {
  width: 100%;
  padding: 10px 0 12px;
  background: rgba(255, 255, 255, 0.96);
  white-space: nowrap;
}

.thumbnail-list {
  display: flex;
  width: max-content;
  gap: 9px;
  padding: 0 clamp(16px, 4vw, 32px);
}

.thumbnail-item {
  flex: none;
  width: clamp(58px, 16vw, 76px);
  height: clamp(58px, 16vw, 76px);
  overflow: hidden;
  border: 2px solid transparent;
  border-radius: 10px;
  background: #edf2f4;
}

.thumbnail-item--active {
  border-color: #63a3a1;
}

.thumbnail-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-content {
  padding: 0 clamp(16px, 4vw, 32px) clamp(36px, 6vw, 60px);
}

.artwork-intro {
  padding: clamp(22px, 4vw, 34px) 0 clamp(18px, 3vw, 26px);
  border-bottom: 1px solid #e3eaee;
}

.artwork-title-row {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.artwork-title {
  display: block;
  min-width: 0;
  color: #122f49;
  font-size: clamp(23px, 4vw, 34px);
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.artwork-publish-time {
  flex: none;
  color: #8b99a5;
  font-size: clamp(10px, 1.5vw, 12px);
  white-space: nowrap;
}

.artwork-meta,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.artwork-meta {
  margin-top: 15px;
}

.meta-chip,
.artwork-tag {
  display: inline-flex;
  flex: none;
  align-items: center;
  border-radius: 999px;
}

.meta-chip {
  min-height: 34px;
  gap: 7px;
  padding: 0 13px;
  background: #eaf2f5;
  color: #38556a;
  font-size: clamp(12px, 1.7vw, 14px);
}

.meta-chip--tool {
  background: #e6f1ef;
  color: #356963;
}

.meta-chip__label {
  color: #81909a;
  font-size: 11px;
}

.tag-list {
  margin-top: 12px;
}

.artwork-tag {
  min-height: 30px;
  padding: 0 11px;
  border: 1px solid #d7e2e8;
  background: rgba(255, 255, 255, 0.72);
  color: #61778a;
  font-size: clamp(11px, 1.6vw, 13px);
}

.content-section {
  padding: clamp(22px, 4vw, 34px) 0;
  border-bottom: 1px solid #e3eaee;
}

.content-heading,
.comments-heading,
.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.content-title,
.comments-title {
  color: #17344e;
  font-size: clamp(18px, 2.7vw, 22px);
  font-weight: 700;
}

.copy-control {
  flex: none;
  color: #67918f;
  font-size: 13px;
}

.content-text {
  display: block;
  margin-top: 13px;
  color: #455f75;
  font-size: clamp(13px, 1.8vw, 16px);
  line-height: 1.75;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.content-text--prompt {
  padding: clamp(14px, 2.5vw, 20px);
  border-radius: 14px;
  background: #eef4f6;
  color: #526a7d;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.comments-section {
  padding-top: clamp(26px, 5vw, 40px);
}

.comment-sort-tabs {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8px;
}

.comment-sort {
  padding: 7px 10px;
  border-radius: 999px;
  color: #8a98a3;
  font-size: clamp(11px, 1.6vw, 13px);
  line-height: 1;
}

.comment-sort--active {
  background: #e5f0ef;
  color: #477b76;
  font-weight: 600;
}

.comment-list {
  margin-top: 10px;
}

.comment-item {
  display: flex;
  min-width: 0;
  gap: 10px;
  padding: clamp(16px, 3vw, 24px) 0;
  border-bottom: 1px solid #e3eaee;
}

.comment-avatar {
  display: flex;
  width: clamp(34px, 8vw, 42px);
  height: clamp(34px, 8vw, 42px);
  align-items: center;
  justify-content: center;
  font-size: 13px;
}

.comment-body,
.comment-author-copy {
  min-width: 0;
}

.comment-body {
  flex: 1;
}

.comment-author,
.comment-time {
  display: block;
}

.comment-author {
  color: #17344e;
  font-size: clamp(12px, 1.7vw, 14px);
  font-weight: 600;
}

.comment-time,
.comment-likes,
.comment-empty {
  color: #8a98a3;
  font-size: clamp(10px, 1.4vw, 12px);
}

.comment-time {
  margin-top: 3px;
}

.comment-likes {
  flex: none;
}

.comment-content {
  display: block;
  margin-top: 8px;
  color: #3e586e;
  font-size: clamp(13px, 1.8vw, 15px);
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.comment-empty {
  display: block;
  padding: 32px 0;
  text-align: center;
}

.loading-page {
  padding-top: 40px;
}

@media (max-width: 359px) {
  .detail-header__inner {
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: 6px;
    padding-left: 8px;
  }

  .back-control {
    width: 36px;
  }

  .creator-avatar {
    width: 34px;
    height: 34px;
  }

  .follow-control {
    min-width: 50px;
    padding: 0 9px;
  }

}

@media (min-width: 760px) {
  .detail-content {
    padding-right: clamp(32px, 6vw, 70px);
    padding-left: clamp(32px, 6vw, 70px);
  }

}
