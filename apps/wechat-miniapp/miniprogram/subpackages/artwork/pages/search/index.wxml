<app-header back transparent />

<view class="page search-page">
  <view class="search-row">
    <view class="search-box">
      <text class="search-box__icon">⌕</text>
      <input
        class="search-box__input"
        value="{{keyword}}"
        placeholder="搜索作品、标签或设计师"
        placeholder-class="search-box__placeholder"
        confirm-type="search"
        bindinput="handleInput"
        bindconfirm="submitSearch"
      />
      <view
        wx:if="{{keyword}}"
        class="search-box__clear"
        bindtap="clearKeyword"
        aria-role="button"
        aria-label="清空搜索内容"
      >×</view>
    </view>
    <view
      class="search-confirm"
      bindtap="submitSearch"
      aria-role="button"
      aria-label="确认搜索"
    >搜索</view>
  </view>

  <block wx:if="{{!hasSearched}}">
  <view class="search-section">
    <view class="section-heading">
      <text class="section-title">历史搜索</text>
      <button
        wx:if="{{searchHistory.length}}"
        class="history-clear"
        bindtap="clearHistory"
      >清空</button>
    </view>
    <view wx:if="{{searchHistory.length}}" class="keyword-list">
      <view
        wx:for="{{searchHistory}}"
        wx:key="*this"
        class="keyword-chip"
        data-keyword="{{item}}"
        bindtap="selectKeyword"
        aria-role="button"
      >{{item}}</view>
    </view>
    <text wx:else class="section-empty">暂无历史搜索记录</text>
  </view>

  <view class="search-section">
    <view class="section-heading">
      <text class="section-title">热搜内容</text>
    </view>
    <view class="hot-search-grid">
      <button
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="hot-search-item"
        data-keyword="{{item}}"
        bindtap="selectKeyword"
      >
        <text class="hot-search-item__rank">{{index + 1}}</text>
        <text class="hot-search-item__text">{{item}}</text>
      </button>
    </view>
  </view>
  </block>

  <view wx:else class="result-section">
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view
          wx:for="{{filters}}"
          wx:key="*this"
          class="filter-chip"
          data-filter="{{item}}"
          bindtap="showFilter"
          aria-role="button"
        >
          <text>{{item}}</text>
          <text class="filter-chip__arrow">⌄</text>
        </view>
      </view>
    </scroll-view>

    <view class="sort-row">
      <view class="sort-tabs">
        <view
          class="sort-tab {{sort === 'latest' ? 'sort-tab--active' : ''}}"
          data-sort="latest"
          bindtap="changeSort"
          aria-role="button"
        >最新发布</view>
        <view
          class="sort-tab {{sort === 'hottest' ? 'sort-tab--active' : ''}}"
          data-sort="hottest"
          bindtap="changeSort"
          aria-role="button"
        >热度排序</view>
      </view>
      <text class="result-count">共 {{artworks.length}} 个结果</text>
    </view>

    <view wx:if="{{artworks.length}}" class="result-grid">
      <view wx:for="{{artworks}}" wx:key="id" class="result-grid__item">
        <artwork-card artwork="{{item}}" bind:select="openArtwork" />
      </view>
    </view>
    <page-state
      wx:else
      state="{{loading ? 'loading' : 'empty'}}"
      title="{{loading ? '正在搜索' : '没有找到相关作品'}}"
      description="{{loading ? '请稍候…' : '试试其他关键词。'}}"
    />
  </view>
</view>
