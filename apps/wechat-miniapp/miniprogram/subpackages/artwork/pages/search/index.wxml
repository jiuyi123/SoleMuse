<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="作品、标签或设计师"
      confirm-type="search"
      bindinput="handleKeywordInput"
      bindconfirm="submitSearch"
    />
    <button class="search-button" bindtap="submitSearch">搜索</button>
  </view>
  <view wx:if="{{selectedTag}}" class="active-filter">当前标签：# {{selectedTag}}</view>
  <view class="filter-row">
    <text>分类</text><text>风格</text><text>AI 来源</text><text>最新发布</text>
  </view>
  <artwork-card
    wx:for="{{artworks}}"
    wx:key="id"
    artwork="{{item}}"
    bind:select="openArtwork"
  />
  <page-state
    wx:if="{{!artworks.length}}"
    title="暂无搜索结果"
    description="输入关键词或调整筛选条件后重试。"
    action-text="清除筛选"
    bind:action="clearSearch"
  />
</view>
