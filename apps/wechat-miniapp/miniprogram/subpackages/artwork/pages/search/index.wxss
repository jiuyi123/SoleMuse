.search-page {
  min-height: calc(100vh - 64px);
  padding-top: clamp(8px, 2vw, 20px);
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 56px;
  width: 100%;
  align-items: center;
  column-gap: 12px;
}

.search-box {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  height: clamp(44px, 7vw, 52px);
  align-items: center;
  border: 1px solid rgba(164, 184, 199, 0.5);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6px 18px rgba(33, 65, 92, 0.08);
}

.search-box__icon {
  flex: 0 0 auto;
  margin-left: clamp(14px, 2.5vw, 20px);
  color: #708497;
  font-family: Georgia, serif;
  font-size: clamp(21px, 3vw, 26px);
  line-height: 1;
}

.search-box__input {
  flex: 1;
  width: 100%;
  height: 100%;
  padding: 0 48px 0 10px;
  color: #17344e;
  font-size: clamp(14px, 2vw, 16px);
}

.search-box__placeholder {
  color: #9aa7b1;
}

.search-box__clear {
  position: absolute;
  z-index: 2;
  top: 50%;
  right: 12px;
  display: flex;
  width: 22px;
  min-width: 22px;
  height: 22px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transform: translateY(-50%);
  background: #c4cdd4;
  color: #ffffff;
  font-size: 17px;
  line-height: 1;
}

.search-confirm {
  display: flex;
  width: 56px;
  height: clamp(44px, 7vw, 52px);
  align-items: center;
  justify-content: flex-end;
  color: #17344e;
  font-size: clamp(15px, 2vw, 17px);
  font-weight: 700;
  line-height: 1;
}

.search-section {
  margin-top: clamp(32px, 7vw, 56px);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: clamp(16px, 3vw, 24px);
}

.section-title {
  color: #142f48;
  font-size: clamp(19px, 3vw, 24px);
  font-weight: 700;
}

.history-clear {
  width: auto;
  min-height: 36px;
  margin: 0;
  padding: 0 4px;
  background: transparent;
  color: #82909b;
  font-size: 13px;
  line-height: 36px;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: flex-start;
  gap: clamp(10px, 2vw, 14px);
}

.keyword-chip {
  display: inline-flex;
  flex: none;
  width: auto;
  max-width: 100%;
  min-height: 38px;
  margin: 0;
  padding: 8px clamp(14px, 2.5vw, 20px);
  overflow: hidden;
  border: 1px solid rgba(177, 196, 210, 0.64);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.76);
  color: #40586c;
  font-size: clamp(13px, 1.8vw, 15px);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-empty {
  color: #929fa9;
  font-size: 14px;
}

.hot-search-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(12px, 2.5vw, 20px);
}

.hot-search-item {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 48px;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 8px clamp(10px, 2vw, 16px);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.72);
  color: #334d62;
  text-align: left;
}

.hot-search-item__rank {
  display: flex;
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #dfeeee;
  color: #58958f;
  font-size: 12px;
  font-weight: 700;
}

.hot-search-item__text {
  min-width: 0;
  overflow: hidden;
  font-size: clamp(13px, 1.8vw, 16px);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-section {
  margin-top: clamp(14px, 3vw, 24px);
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-list {
  display: flex;
  width: max-content;
  min-width: 100%;
  gap: 8px;
  padding: 1px 0 3px;
}

.filter-chip {
  display: inline-flex;
  flex: none;
  min-height: 34px;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 13px;
  border: 1px solid rgba(185, 202, 215, 0.46);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.82);
  color: #405568;
  font-size: clamp(12px, 1.7vw, 14px);
  line-height: 1;
}

.filter-chip__arrow {
  margin-top: -2px;
  color: #7f8d98;
  font-size: 13px;
}

.sort-row {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.sort-tabs {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: clamp(18px, 5vw, 32px);
}

.sort-tab {
  flex: none;
  padding: 7px 0;
  color: #9ba5ad;
  font-size: clamp(13px, 1.9vw, 15px);
  line-height: 1;
}

.sort-tab--active {
  color: #17344e;
  font-weight: 700;
}

.result-count {
  flex: none;
  color: #9ba5ad;
  font-size: clamp(11px, 1.6vw, 13px);
  white-space: nowrap;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(10px, 2.2vw, 22px);
  align-items: stretch;
}

.result-grid__item {
  width: 100%;
}

.history-clear::after,
.hot-search-item::after {
  border: 0;
}

@media (max-width: 359px) {
  .search-row {
    grid-template-columns: minmax(0, 1fr) 48px;
    column-gap: 8px;
  }

  .search-confirm {
    width: 48px;
  }
}

@media (min-width: 600px) {
  .hot-search-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  .result-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 900px) {
  .hot-search-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (min-width: 1200px) {
  .result-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
