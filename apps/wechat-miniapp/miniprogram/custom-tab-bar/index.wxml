<view class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{items}}"
      wx:key="path"
      class="tab-item {{selected === index ? 'tab-item--active' : ''}} {{item.raised ? 'tab-item--raised' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <text class="tab-icon">{{item.icon}}</text>
        <text wx:if="{{index === 3 && unread}}" class="tab-badge">{{unread}}</text>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
