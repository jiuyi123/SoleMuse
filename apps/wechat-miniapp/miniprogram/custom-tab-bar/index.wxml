<view wx:if="{{!hidden}}" class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{items}}"
      wx:key="path"
      class="tab-item {{ready && selected === index ? 'tab-item--active' : ''}} {{item.raised ? 'tab-item--raised' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      aria-role="button"
      aria-label="{{item.text}}"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon tab-icon--default" src="{{item.icon}}" mode="aspectFit" />
        <image class="tab-icon tab-icon--active" src="{{item.activeIcon}}" mode="aspectFit" />
        <text wx:if="{{index === 3 && unread}}" class="tab-badge">{{unread}}</text>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>

<view
  wx:if="{{transitionVisible}}"
  class="creation-transition-lock"
  catchtap="blockTransitionInteraction"
  catchtouchmove="blockTransitionInteraction"
  aria-hidden="true"
>
  <view
    class="creation-transition-circle {{transitionExpanded ? 'creation-transition-circle--expanded' : ''}}"
    style="left: {{transitionX}}px; top: {{transitionY}}px; transform: translate3d(-50%, -50%, 0) scale({{transitionScale}});"
  ></view>
</view>
