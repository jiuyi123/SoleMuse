.tab-shell { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid rgba(218, 226, 231, 0.75); background: #fff; box-shadow: 0 -5px 20px rgba(51, 78, 96, 0.07); }
.tab-bar { position: relative; display: flex; width: min(100%, 760px); height: 66px; margin: 0 auto; padding: 3px 7px 2px; }
.tab-item { position: relative; z-index: 1; display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; color: #89959e; transition: color 180ms ease, transform 160ms ease; }
.tab-item:active { transform: scale(0.96); }
.tab-icon-wrap { position: relative; display: flex; width: 42px; height: 32px; align-items: center; justify-content: center; border-radius: 16px; transition: transform 160ms ease; }
.tab-icon-wrap::before { position: absolute; z-index: 0; top: 0; right: 0; bottom: 0; left: 0; border-radius: inherit; background: linear-gradient(135deg, rgba(103, 179, 168, 0.13), rgba(76, 136, 189, 0.1)); content: ""; opacity: 0; transform: scale(0.88); transition: opacity 150ms ease, transform 170ms ease; }
.tab-icon { position: absolute; z-index: 1; width: 27px; height: 27px; transition: opacity 130ms ease, transform 160ms ease; }
.tab-icon--default { opacity: 1; }
.tab-icon--active { opacity: 0; transform: scale(0.9); }
.tab-label { max-width: 100%; margin-top: 3px; overflow: hidden; font-size: 10px; font-weight: 500; letter-spacing: 0.2px; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
.tab-item--active { color: #315f78; }
.tab-item--active .tab-icon-wrap { transform: translateY(-1px); }
.tab-item--active .tab-icon-wrap::before { opacity: 1; transform: scale(1); }
.tab-item--active .tab-icon--default { opacity: 0; transform: scale(0.92); }
.tab-item--active .tab-icon--active { opacity: 1; transform: scale(1); }
.tab-item--active .tab-label { font-weight: 650; }
.tab-item--raised .tab-icon-wrap, .tab-item--active.tab-item--raised .tab-icon-wrap { width: 56px; height: 56px; margin-top: -30px; border: 4px solid rgba(255, 255, 255, 0.98); border-radius: 50%; background: linear-gradient(145deg, #70b7aa 0%, #5b9cc5 56%, #548abd 100%); box-shadow: 0 7px 18px rgba(67, 128, 164, 0.28), 0 2px 5px rgba(46, 93, 122, 0.13); transform: none; }
.tab-item--raised .tab-icon-wrap::before { display: none; }
.tab-item--raised .tab-icon { width: 36px; height: 36px; }
.tab-item--raised .tab-icon--default { opacity: 1; transform: none; }
.tab-item--raised .tab-icon--active { display: none; }
.tab-item--raised .tab-label { margin-top: 3px; color: #47718a; font-weight: 650; }
.tab-badge { position: absolute; z-index: 2; top: -4px; right: -5px; min-width: 17px; height: 17px; padding: 0 4px; border: 2px solid #fff; border-radius: 999px; background: linear-gradient(145deg, #f47983, #e85262); color: #fff; font-size: 9px; font-weight: 650; line-height: 13px; text-align: center; }

.creation-transition-lock {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  touch-action: none;
}

.creation-transition-circle {
  position: absolute;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 36%, #7db4ae 0%, #75aaa4 34%, #66a8d4 100%);
  box-shadow: 0 0 36px 12px rgba(102, 168, 212, 0.3);
  opacity: 0.92;
  transform-origin: center;
  backface-visibility: hidden;
  will-change: transform, opacity;
  transition:
    transform 560ms cubic-bezier(0.18, 0.82, 0.22, 1),
    opacity 180ms ease-out;
}

.creation-transition-circle--expanded {
  opacity: 1;
}

@media (min-width: 1024px) {
  .tab-shell { right: 50%; bottom: 18px; left: auto; width: min(700px, calc(100vw - 64px)); padding-bottom: 0; border: 1px solid rgba(202, 215, 223, 0.72); border-radius: 24px; transform: translateX(50%); box-shadow: 0 12px 34px rgba(45, 76, 96, 0.14); }
  .tab-bar { height: 66px; }
}
