<app-header title="榜单" transparent />

<view class="page tab-page ranking-page">
  <view class="ranking-toolbar">
    <view class="period-switch" aria-label="榜单周期">
      <view
        wx:for="{{periods}}"
        wx:key="value"
        class="period {{period === item.value ? 'period--active' : ''}}"
        data-period="{{item.value}}"
        bindtap="changePeriod"
        aria-role="button"
      >
        <text wx:if="{{period === item.value}}" class="period__dot"></text>
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="ranking-toolbar__meta">
      <text class="ranking-update">每小时更新 · 公开热度排行</text>
      <view class="rules-link" bindtap="toggleRules" aria-role="button">排行规则 <text>ⓘ</text></view>
    </view>
  </view>

  <view class="podium-stage">
    <view wx:for="{{podiums}}" wx:key="rank" class="podium podium--{{item.rank}}" data-id="{{item.artworkId}}" bindtap="openArtwork">
      <view class="podium-rank">{{item.rank}}</view>
      <view class="podium-image-wrap"><image src="{{item.image}}" mode="aspectFill" /></view>
      <text class="podium-title">{{item.title}}</text>
      <view class="author-line author-line--podium">
        <image wx:if="{{item.avatarUrl}}" class="author-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="author-avatar author-avatar--fallback">{{item.authorInitial}}</view>
        <text class="author-name">{{item.author}}</text>
      </view>
      <view class="metric-row metric-row--podium">
        <view class="metric metric--like"><image src="/assets/icons/heart-filled.svg" /><text>{{item.metrics.likes}}</text></view>
        <view class="metric metric--favorite"><image src="/assets/icons/star-filled.svg" /><text>{{item.metrics.favorites}}</text></view>
        <view class="metric metric--comment"><view class="comment-icon"></view><text>{{item.metrics.comments}}</text></view>
      </view>
    </view>
  </view>

  <view class="ranking-list">
    <view wx:for="{{ranking}}" wx:key="rank" class="ranking-row" data-id="{{item.artworkId}}" bindtap="openArtwork">
      <text class="rank-number">{{item.rank}}</text>
      <image class="rank-image" src="{{item.image}}" mode="aspectFill" />
      <view class="rank-copy">
        <text class="rank-title">{{item.title}}</text>
        <text class="rank-subtitle">{{item.subtitle}}</text>
        <view class="author-line">
          <image wx:if="{{item.avatarUrl}}" class="author-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="author-avatar author-avatar--fallback">{{item.authorInitial}}</view>
          <text class="author-name">{{item.author}}</text>
        </view>
        <view class="metric-row">
          <view class="metric metric--like"><image src="/assets/icons/heart-filled.svg" /><text>{{item.metrics.likes}}</text></view>
          <view class="metric metric--favorite"><image src="/assets/icons/star-filled.svg" /><text>{{item.metrics.favorites}}</text></view>
          <view class="metric metric--comment"><view class="comment-icon"></view><text>{{item.metrics.comments}}</text></view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showRules}}" class="rule-mask" bindtap="toggleRules">
  <view class="rule-dialog" catchtap="noop">
    <text class="rule-title">榜单规则</text>
    <text>榜单按公开热度规则生成，不因个人用户而变化。当前页面为开发示例，正式计算口径和更新时间以后端规则为准。</text>
    <button bindtap="toggleRules">知道了</button>
  </view>
</view>
