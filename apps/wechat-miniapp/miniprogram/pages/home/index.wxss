.home-hero {
  padding: 36rpx 0 20rpx;
}

.home-hero__eyebrow,
.home-hero__title,
.home-hero__copy {
  display: block;
}

.home-hero__eyebrow {
  color: #877b69;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.home-hero__title {
  max-width: 600rpx;
  margin-top: 24rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.18;
}

.home-hero__copy {
  margin-top: 20rpx;
  color: #706b65;
  line-height: 1.6;
}

.search-entry {
  margin-top: 36rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e6e1da;
  border-radius: 44rpx;
  background: #ffffff;
  color: #9a958e;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 88rpx;
  text-align: left;
}

.section {
  margin-top: 42rpx;
}

.section__title {
  display: block;
  margin-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 650;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #ebe6de;
  color: #514b43;
  font-size: 24rpx;
  line-height: 64rpx;
}
