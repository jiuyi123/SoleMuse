.home-fixed-header { position: fixed; z-index: 80; top: 0; right: 0; left: 0; width: 100%; }
.home-topbar { position: relative; width: 100%; min-height: 76px; max-height: 116px; overflow: hidden; }
.home-topbar__image, .home-topbar__veil { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.home-topbar__image { object-fit: cover; object-position: center 58%; }
.home-topbar__veil { background: linear-gradient(105deg, rgba(18, 54, 77, .92), rgba(32, 90, 106, .66) 58%, rgba(139, 186, 157, .28)); }
.home-topbar app-header { position: relative; z-index: 2; }
.home-topbar__inner { position: absolute; z-index: 1; right: 0; bottom: 7px; left: 0; display: flex; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); align-items: flex-end; color: #fff; }
.home-topbar__brand { width: min(66%, 520px); min-width: 0; }
.home-topbar__logo, .home-topbar__name { display: block; max-width: 100%; overflow-wrap: anywhere; }
.home-topbar__logo { font-family: Georgia, "Songti SC", serif; font-size: clamp(19px, 4vw, 28px); font-weight: 600; letter-spacing: clamp(1px, .3vw, 2px); }
.home-topbar__name { margin-top: 1px; overflow: hidden; font-size: clamp(8px, 1.4vw, 11px); letter-spacing: clamp(.2px, .1vw, .8px); text-overflow: ellipsis; white-space: nowrap; }

.home-page { overflow: visible; }

.home-nav-shell { width: 100%; border-bottom: 1px solid rgba(186, 204, 217, .72); background: rgba(245, 250, 252, .97); box-shadow: 0 5px 14px rgba(35, 74, 101, .05); backdrop-filter: blur(12px); }
.home-nav { display: flex; width: 100%; max-width: 1200px; min-width: 0; height: 40px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); align-items: stretch; justify-content: space-between; }
.home-nav__tabs { display: flex; min-width: 0; flex: 1; align-items: stretch; justify-content: space-around; }
.home-nav__tab { position: relative; flex: 1; min-width: 0; min-height: 40px; margin: 0; padding: 0 4px 5px; overflow: hidden; background: transparent; color: #8793a1; font-size: clamp(15px, 3.4vw, 21px); line-height: 35px; text-overflow: ellipsis; white-space: nowrap; }
.home-nav__tab::after, .home-nav__search::after { border: 0; }
.home-nav__tab--active { color: #132f4b; font-weight: 700; }
.home-nav__tab--active::before { position: absolute; right: 30%; bottom: -1px; left: 30%; height: 3px; border-radius: 999px; background: linear-gradient(90deg, #64a398, #65a8d2); content: ""; }
.home-nav__search { display: flex; flex: 0 0 clamp(42px, 10vw, 54px); align-items: center; justify-content: flex-end; min-height: 40px; margin: 0; padding: 0 2px 5px 8px; background: transparent; color: #17344e; }
.home-nav__search text { font-family: Georgia, serif; font-size: clamp(24px, 5vw, 32px); line-height: 1; }

.tag-scroll { width: 100%; margin-top: 9px; white-space: nowrap; }
.tag-list { display: flex; width: max-content; gap: 6px; padding: 1px 0; }
.hot-tag { display: inline-flex; flex: none; width: max-content; min-height: 26px; margin: 0; padding: 0 6px; align-items: center; justify-content: center; border: 1px solid rgba(184, 203, 220, .7); border-radius: 999px; background: rgba(255,255,255,.76); color: #4c687f; font-size: clamp(10px, 1.45vw, 12px); line-height: 1; white-space: nowrap; }
.hot-tag:first-child { border-color: transparent; background: linear-gradient(120deg, #6ca59c, #76acd2); color: #fff; }

.artwork-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 2.2vw, 22px); align-items: stretch; margin-top: clamp(14px, 3vw, 24px); }
.artwork-grid__item { width: 100%; }

@media (min-width: 768px) {
  .artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .home-nav__tabs { max-width: 520px; }
}

@media (min-width: 1200px) {
  .artwork-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
