page {
  background: #f3f7f9;
}

.publish-page {
  min-height: 100vh;
}

.publish-page--transition-arrival {
  background: #66a8d4;
  transition: background-color 260ms ease-out;
}

.publish-page--transition-arrival > .publish-header,
.publish-page--transition-arrival > .publish-content,
.publish-page--transition-arrival > .bottom-action-bar {
  opacity: 0;
  transform: translate3d(0, 8px, 0);
  transition:
    opacity 260ms ease-out,
    transform 260ms cubic-bezier(0.2, 0.75, 0.25, 1);
  will-change: opacity, transform;
}

.publish-page--transition-arrival.publish-page--ready {
  background: #f3f7f9;
}

.publish-page--transition-arrival.publish-page--ready > .publish-header,
.publish-page--transition-arrival.publish-page--ready > .publish-content,
.publish-page--transition-arrival.publish-page--ready > .bottom-action-bar {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

.publish-header {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 1px 0 rgba(38, 73, 96, 0.06);
  backdrop-filter: blur(12px);
}

.publish-header__bar {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
  width: 100%;
  align-items: center;
  gap: 8px;
  padding-left: 12px;
}

.publish-header__back {
  display: flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
}

.publish-header__back-icon {
  width: 12px;
  height: 12px;
  margin-left: 5px;
  border-bottom: 2px solid #18344e;
  border-left: 2px solid #18344e;
  transform: rotate(45deg);
}

.publish-header__titles {
  min-width: 0;
}

.publish-header__title,
.publish-header__subtitle {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.publish-header__title {
  color: #172f45;
  font-size: clamp(19px, 4.8vw, 23px);
  font-weight: 700;
  line-height: 1.2;
}

.publish-header__subtitle {
  margin-top: 2px;
  color: #8a94a6;
  font-size: clamp(12px, 3.4vw, 14px);
  line-height: 1.25;
}

.publish-content {
  display: flex;
  max-width: 760px;
  min-height: 100vh;
  flex-direction: column;
  padding-right: 10px;
  padding-bottom: calc(82px + env(safe-area-inset-bottom));
  padding-left: 10px;
  overflow-x: hidden;
}

.upload-card,
.form-card {
  width: 100%;
  border-radius: 17px;
  background: #ffffff;
  box-shadow: 0 4px 16px rgba(44, 76, 98, 0.06);
}

.upload-card {
  padding: 12px;
}

.upload-card__main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.upload-placeholder {
  display: flex;
  width: clamp(82px, 23vw, 90px);
  height: clamp(82px, 23vw, 90px);
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px dashed #58aaa5;
  border-radius: 13px;
  background: #f2faf9;
  color: #249b95;
}

.upload-placeholder--disabled {
  border-color: #cbd7dc;
  background: #f5f7f8;
  color: #9aa8b0;
}

.upload-placeholder__plus {
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

.upload-placeholder__label {
  margin-top: 6px;
  font-size: 12px;
  font-weight: 600;
}

.upload-info {
  flex: 1;
  min-width: 0;
}

.upload-info__heading {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.upload-info__title,
.upload-info__description,
.upload-info__hint {
  display: block;
  overflow-wrap: anywhere;
}

.upload-info__title {
  color: #18344d;
  font-size: clamp(14px, 3.8vw, 16px);
  font-weight: 600;
}

.upload-info__count {
  flex: none;
  color: #6b9e9a;
  font-size: 12px;
}

.upload-info__description {
  margin-top: 7px;
  color: #718293;
  font-size: clamp(11px, 3.2vw, 13px);
  line-height: 1.4;
}

.upload-info__hint {
  margin-top: 5px;
  color: #a0aab5;
  font-size: clamp(10px, 2.8vw, 12px);
  line-height: 1.35;
}

.uploaded-images {
  width: 100%;
  margin-top: 10px;
  white-space: nowrap;
}

.uploaded-images__list {
  display: flex;
  width: max-content;
  gap: 8px;
}

.uploaded-image {
  position: relative;
  width: 58px;
  height: 58px;
  flex: none;
  overflow: hidden;
  border-radius: 10px;
  background: #eef3f5;
}

.uploaded-image__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.uploaded-image__cover {
  position: absolute;
  bottom: 4px;
  left: 4px;
  padding: 2px 6px;
  border-radius: 999px;
  background: rgba(24, 52, 77, 0.72);
  color: #ffffff;
  font-size: 9px;
}

.form-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  gap: clamp(10px, 1.6vh, 16px);
  margin-top: 10px;
  padding: 10px 12px;
}

.form-field {
  position: relative;
  display: block;
  margin-bottom: 0;
}

.form-field--choices {
  margin-bottom: 0;
}

.form-field--choices .form-field__label {
  margin-bottom: 2px;
}

.form-field__label {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 4px;
  margin-bottom: 4px;
  color: #18344d;
  font-size: clamp(13px, 3.5vw, 15px);
  font-weight: 600;
  line-height: 1.2;
}

.required-mark {
  color: #dd5967;
  font-size: 14px;
  font-weight: 700;
}

.form-control {
  width: 100%;
  min-height: 40px;
  padding: 8px 12px;
  border: 1px solid #d8e3e8;
  border-radius: 11px;
  background: #fbfcfd;
  color: #29465e;
  font-size: clamp(13px, 3.5vw, 15px);
  overflow-wrap: anywhere;
}

.form-control--textarea {
  height: clamp(70px, 20vw, 78px);
  padding-bottom: 25px;
  line-height: 1.45;
}

.form-control--short {
  height: clamp(64px, 18vw, 72px);
}

.form-field__count {
  position: absolute;
  right: 12px;
  bottom: 7px;
  color: #9aa7b5;
  font-size: 10px;
}

.form-field__prompt-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.form-field__label--inline {
  margin-bottom: 0;
}

.paste-control {
  display: inline-flex;
  width: auto;
  min-height: 27px;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
  border: 1px solid #bdd2d8;
  border-radius: 999px;
  background: #ffffff;
  color: #50807d;
  font-size: 12px;
  line-height: 1;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.picker-control__arrow {
  flex: none;
  color: #93a2ad;
  font-size: 22px;
  transform: rotate(90deg);
}

.choice-scroll {
  width: 100%;
  white-space: nowrap;
}

.choice-list {
  display: flex;
  width: max-content;
  min-width: 100%;
  flex-wrap: nowrap;
  justify-content: flex-start;
  gap: 5px;
}

.choice-chip {
  display: inline-flex;
  width: auto;
  min-height: 26px;
  flex: none;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 9px;
  border: 1px solid #d6e2e7;
  border-radius: 999px;
  background: #ffffff;
  color: #3d586d;
  font-size: clamp(11px, 2.9vw, 12px);
  line-height: 24px;
  white-space: nowrap;
}

.choice-chip--active {
  border-color: #52a9a3;
  background: #ffffff;
  color: #247f7a;
  box-shadow: inset 0 0 0 1px rgba(82, 169, 163, 0.18);
}

.choice-chip--custom {
  border-style: dashed;
  background: #ffffff;
  color: #557086;
}

.description-field {
  padding-top: 2px;
}

.description-toggle {
  display: flex;
  min-height: 38px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 12px;
  border-radius: 11px;
  background: #f3f7f8;
  color: #456174;
  font-size: 13px;
  font-weight: 600;
}

.description-toggle__label {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7px;
}

.description-toggle__plus {
  color: #289b95;
  font-size: 20px;
  font-weight: 400;
}

.description-toggle__arrow {
  flex: none;
  color: #8a99a5;
  font-size: 17px;
  transition: transform 160ms ease;
}

.description-toggle__arrow--expanded {
  transform: rotate(180deg);
}

.description-content {
  position: relative;
  margin-top: 7px;
}

.bottom-action-bar {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 9px 16px calc(9px + env(safe-area-inset-bottom));
  border-top: 1px solid #e7edef;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4px 14px rgba(44, 76, 98, 0.05);
}

.bottom-action-bar__inner {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  width: 100%;
  max-width: 728px;
  gap: 12px;
  margin: 0 auto;
}

.bottom-action-bar button {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 46px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 12px;
  border-radius: 26px;
  font-size: clamp(14px, 3.8vw, 16px);
  font-weight: 600;
  line-height: 1;
}

.bottom-action-bar button::after {
  border: 0;
}

.bottom-action-bar__draft {
  background: #edf2f5;
  color: #475d6e;
}

.bottom-action-bar__publish {
  background: #20a49d;
  color: #ffffff;
}

@media (max-width: 359px) {
  .publish-header__bar {
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 6px;
    padding-left: 8px;
  }

  .publish-header__back {
    width: 38px;
  }

  .publish-content {
    padding-right: 8px;
    padding-left: 8px;
  }

  .upload-card {
    padding: 10px;
  }

  .upload-card__main {
    gap: 9px;
  }

  .upload-placeholder {
    width: 80px;
    height: 80px;
  }

  .upload-info__description {
    margin-top: 5px;
    font-size: 11px;
  }

  .upload-info__hint {
    margin-top: 4px;
    font-size: 10px;
  }

  .form-card {
    padding: 9px 10px;
  }

  .bottom-action-bar {
    padding-right: 12px;
    padding-left: 12px;
  }
}
