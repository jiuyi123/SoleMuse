<view class="page">
  <view class="profile-card panel">
    <view class="profile-avatar">S</view>
    <view class="profile-summary">
      <text class="profile-name">{{isAuthenticated ? 'SoleMuse 用户' : '欢迎来到 SoleMuse'}}</text>
      <text class="muted">{{isAuthenticated ? '完善资料，让同行更了解你' : '登录后管理作品与互动记录'}}</text>
    </view>
    <button wx:if="{{isAuthenticated}}" class="profile-action" bindtap="editProfile">编辑</button>
    <button wx:else class="profile-action" bindtap="openLogin">登录</button>
  </view>

  <view class="panel">
    <view class="list-row" data-type="artworks" bindtap="openContent"><text>我的作品</text><text>›</text></view>
    <view class="list-row" data-type="favorites" bindtap="openContent"><text>我的收藏</text><text>›</text></view>
    <view class="list-row" data-type="likes" bindtap="openContent"><text>我的点赞</text><text>›</text></view>
    <view class="list-row" data-type="comments" bindtap="openContent"><text>我的评论</text><text>›</text></view>
  </view>
</view>
