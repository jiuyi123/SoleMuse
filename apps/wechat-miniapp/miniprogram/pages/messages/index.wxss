page { height: 100%; overflow: hidden; background: #fff; }

.message-page {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  padding-top: 0;
  padding-right: 0;
  padding-left: 0;
  background: #fff;
}

.message-header { flex: 0 0 auto; background: #fff; }
.message-header__bar { position: relative; display: flex; align-items: center; justify-content: center; }
.message-header__title { color: #222b33; font-size: 18px; font-weight: 600; line-height: 1.2; }

.message-channels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; padding: 22px 12px 20px; }
.message-channel { position: relative; display: flex; min-width: 0; flex-direction: column; align-items: center; }
.message-channel__icon { display: flex; width: 54px; height: 54px; align-items: center; justify-content: center; border-radius: 17px; font-size: 27px; line-height: 1; transition: transform 160ms ease; }
.message-channel__icon--rose { background: #fff0f1; color: #f05f69; }
.message-channel__icon--blue { background: #edf4ff; }
.message-channel__icon--mint { background: #eaf9f4; }
.message-channel__image { width: 42px; height: 42px; }
.message-channel:active .message-channel__icon { transform: scale(0.96); }
.message-channel__title { margin-top: 9px; overflow: hidden; color: #2a3239; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
.message-channel__badge { position: absolute; top: -4px; right: calc(50% - 34px); min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px; background: #f04452; color: #fff; font-size: 10px; line-height: 16px; text-align: center; }

.message-list { height: 0; min-height: 0; flex: 1; padding: 4px 12px 24px; }
.message-row { display: flex; min-height: 78px; align-items: center; gap: 12px; padding: 12px 0; }
.message-row__leading { flex: 0 0 52px; width: 52px; height: 52px; }
.message-row__avatar, .message-row__icon { display: flex; width: 52px; height: 52px; align-items: center; justify-content: center; border-radius: 50%; object-fit: cover; }
.message-row__avatar--interactive:active { opacity: .76; transform: scale(.96); }
.message-row__icon { color: #fff; font-size: 22px; font-weight: 700; }
.message-row__icon--rose { background: linear-gradient(145deg, #f3a0a6, #eb6370); }
.message-row__icon--mint { background: linear-gradient(145deg, #8be0c8, #36bd96); }
.message-row__icon--blue { background: linear-gradient(145deg, #72a9f2, #3977dc); }
.message-row__icon--cyan { background: linear-gradient(145deg, #8bd4d1, #4e9fa7); }
.message-row__body { flex: 1; min-width: 0; }
.message-row__heading { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 10px; }
.message-row__title { min-width: 0; overflow: hidden; color: #252d34; font-size: 16px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.message-row__time { flex: 0 0 auto; color: #a0a7ad; font-size: 12px; }
.message-row__summary { display: block; margin-top: 5px; overflow: hidden; color: #9aa1a7; font-size: 13px; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.message-row__unread { flex: 0 0 8px; width: 8px; height: 8px; border-radius: 50%; background: #f04452; }

@media (min-width: 700px) {
  .message-channels { max-width: 660px; margin: 0 auto; padding-top: 30px; }
  .message-list { width: min(760px, 100%); margin-right: auto; margin-left: auto; }
}
