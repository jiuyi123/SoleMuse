<view class="page tab-page message-page">
  <view class="message-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="message-header__bar" style="height: {{navigationHeight}}px;">
      <text class="message-header__title">消息</text>
    </view>
  </view>

  <page-state wx:if="{{!isAuthenticated}}" title="登录后查看消息" description="登录成功后会回到消息页。" action-text="去登录" bind:action="openLogin" />

  <page-state wx:elif="{{loading && !messages.length}}" state="loading" title="正在整理消息" description="新的互动与灵感正在赶来…" />
  <page-state wx:elif="{{loadFailed && !messages.length}}" state="error" title="消息加载失败" description="请检查网络后重试。" action-text="重新加载" bind:action="loadMessages" />

  <block wx:else>
    <view class="message-channels">
      <view wx:for="{{channels}}" wx:key="key" class="message-channel" data-filter="{{item.filter}}" data-title="{{item.title}}" bindtap="openChannel" aria-role="button">
        <view class="message-channel__icon message-channel__icon--{{item.tone}}">
          <image class="message-channel__image" src="{{item.iconAsset}}" mode="aspectFit" />
        </view>
        <text class="message-channel__title">{{item.title}}</text>
        <view wx:if="{{item.unread}}" class="message-channel__badge">{{item.unread}}</view>
      </view>
    </view>

    <scroll-view wx:if="{{visibleMessages.length}}" class="message-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{visibleMessages}}" wx:key="id" class="message-row" data-id="{{item.id}}" bindtap="openMessage" aria-role="button">
        <view class="message-row__leading">
          <image wx:if="{{item.avatarUrl || item.image}}" class="message-row__avatar" src="{{item.avatarUrl || item.image}}" mode="aspectFill" />
          <view wx:else class="message-row__icon message-row__icon--{{item.tone}}">{{item.icon}}</view>
        </view>
        <view class="message-row__body">
          <view class="message-row__heading">
            <text class="message-row__title">{{item.title}}</text>
            <text class="message-row__time">{{item.time}}</text>
          </view>
          <text class="message-row__summary">{{item.summary}}</text>
        </view>
        <view wx:if="{{item.unread}}" class="message-row__unread"></view>
      </view>
    </scroll-view>
    <page-state wx:else title="这一栏很安静" description="新的互动与通知会第一时间出现在这里。" />
  </block>
</view>
