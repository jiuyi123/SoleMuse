page {
  box-sizing: border-box;
  min-height: 100%;
  background: #f7f5f2;
  color: #171512;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #706b65;
  font-size: 26rpx;
  line-height: 1.6;
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ece8e2;
  border-radius: 24rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  background: #171512;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #d8d3cc;
  background: #ffffff;
  color: #171512;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.list-row:last-child {
  border-bottom: 0;
}

.muted {
  color: #8a857f;
}
