.app-header { position: relative; z-index: 20; width: 100%; overflow: hidden; background: rgba(235, 245, 249, 0.9); backdrop-filter: blur(12px); }
.app-header--transparent { background: transparent; backdrop-filter: none; }
.app-header__bar { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 clamp(96px, 16vw, 190px) 0 clamp(52px, 8vw, 88px); }
.app-header__title { max-width: min(62vw, 520px); overflow: hidden; color: #0c294a; font-size: clamp(17px, 2.6vw, 24px); font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.app-header__back { position: absolute; top: 50%; left: clamp(10px, 2.5vw, 24px); display: flex; align-items: center; justify-content: center; width: clamp(36px, 6vw, 44px); height: clamp(36px, 6vw, 44px); margin: 0; padding: 0; border-radius: 50%; transform: translateY(-50%); background: rgba(255, 255, 255, 0.84); color: #153555; font-family: Georgia, serif; font-size: clamp(28px, 5vw, 36px); font-weight: 300; line-height: 1; }
.app-header__back::after { border: 0; }
