.app-header { position: relative; z-index: 20; width: 100%; overflow: hidden; background: rgba(235, 245, 249, 0.9); backdrop-filter: blur(12px); }
.app-header--transparent { background: transparent; backdrop-filter: none; }
.app-header__bar { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 96px 0 52px; }
.app-header__title { max-width: min(62vw, 520px); overflow: hidden; color: #0c294a; font-size: clamp(17px, 2.6vw, 24px); font-weight: 700; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.app-header__back { position: absolute; top: 50%; left: 12px; display: flex; flex: 0 0 40px; width: 40px; height: 40px; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; transform: translateY(-50%); background: transparent; }
.app-header__back-icon { width: 11px; height: 11px; margin-left: 4px; border-bottom: 2px solid #153555; border-left: 2px solid #153555; transform: rotate(45deg); }

@media (min-width: 600px) {
  .app-header__bar { padding-right: 140px; padding-left: 64px; }
  .app-header__back { left: 20px; }
}

@media (min-width: 900px) {
  .app-header__bar { padding-right: 190px; padding-left: 88px; }
}
