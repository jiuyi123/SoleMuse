<view class="app-header {{transparent ? 'app-header--transparent' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="app-header__bar" style="height: {{navigationHeight}}px;">
    <button wx:if="{{back}}" class="app-header__back" bindtap="goBack" aria-label="返回">‹</button>
    <text class="app-header__title">{{title}}</text>
  </view>
</view>
